-- %% sql
SELECT *
FROM members;

-- %% sql
SELECT *
FROM loans;

-- %% sql
SELECT book_title, days
FROM loans
WHERE member_id = 201;

-- %% sql
SELECT *
FROM loans
WHERE loan_id = 2;

-- %% sql
UPDATE loans
SET days = 21
WHERE loan_id = 2;

-- %% sql
DELETE FROM loans
WHERE loan_id = 4;

-- %% sql
ALTER TABLE loans
ADD COLUMN returned_on DATE;

-- %% sql
DESCRIBE loans;

