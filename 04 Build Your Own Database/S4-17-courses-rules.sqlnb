-- %% sql
USE campus_lab;

-- %% sql
CREATE TABLE courses (
    course_id INT PRIMARY KEY,
    title VARCHAR(60) NOT NULL UNIQUE,
    fee_usd DECIMAL(8,2) NOT NULL CHECK (fee_usd > 0),
    seats INT NOT NULL DEFAULT 30
);

-- %% sql
DESCRIBE courses;

