-- %% md
-- ## Task 1. Connect
-- Click the connection at the top right and pick Local MySQL, the connection you tested.

-- %% md
-- ## Task 2. Hello, SQL!
-- Run the cell below and read the answer: one column, one row.

-- %% sql
SELECT 'Hello, SQL!';

-- %% md
-- ## Task 3. Your own name
-- Change only the text between the quotes to your own name, then run it.

-- %% sql
SELECT 'Hello, your name!';

-- %% md
-- ## Task 4. Three at once
-- Run this cell with three statements and find all three answers.

-- %% sql
SELECT 'Step one';
SELECT 'Step two';
SELECT 'Step three';

-- %% md
-- ## Task 5. Fix the error
-- This statement has a typing mistake. Run it, read the error message and the part after "near", then fix it and run it again.

-- %% sql
SELCT 'Fix me';

