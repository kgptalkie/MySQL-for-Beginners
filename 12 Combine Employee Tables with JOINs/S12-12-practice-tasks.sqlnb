-- %% sql

-- %% md
-- ## Task 2. Empty departments
--
-- For every department: department_name and people (how many employees it has). A department with nobody must show 0. Fewest people first.

-- %% sql

-- %% md
-- ## Task 3. Who leads each Sales project?
--
-- For every project of Sales (department 50): project_name and the first_name and last_name of its Lead (project_role 'Lead'). Order by project_name.

-- %% sql

-- %% md
-- ## Task 4. Fix an inflated payroll
--
-- A colleague wrote the query in the cell below for Marketing (department 40). It says 84 people and a payroll of 5469500.00, but Marketing has 46 people. Run it, explain in one sentence what went wrong, then write a query in the empty cell under it that gives Marketing's right headcount and payroll.

-- %% sql
SELECT COUNT(*) AS people,
  SUM(e.salary_usd) AS payroll
FROM employees AS e
LEFT JOIN employee_projects AS ep
  ON e.employee_id = ep.employee_id
WHERE e.department_id = 40;
-- %% sql
