-- sqlnb v1 {"connection":"Local MySQL"}
-- %% sql
USE my_db;

-- %% sql
SELECT department_id, first_name, last_name,
salary_usd,
ROW_NUMBER() OVER (
    PARTITION BY department_id
    ORDER BY salary_usd DESC, employee_id
) AS salary_pos
FROM employees
WHERE department_id = 90
ORDER BY salary_pos;

-- %% sql
SELECT department_id, first_name, salary_usd
FROM employees
WHERE ROW_NUMBER() OVER (
    PARTITION BY department_id
    ORDER BY salary_usd DESC, employee_id
) <= 3;

-- %% sql
WITH ranked AS (
    SELECT department_id, first_name, last_name,
    salary_usd,
    ROW_NUMBER() OVER (
        PARTITION BY department_id
        ORDER BY salary_usd DESC, employee_id
    ) AS salary_pos
    FROM employees
)
SELECT *
FROM ranked
WHERE salary_pos <= 3
AND department_id IN (30, 40, 90)
ORDER BY department_id, salary_pos;

-- %% sql
WITH ranked AS (
    SELECT department_id, first_name, last_name,
    salary_usd,
    ROW_NUMBER() OVER (
        PARTITION BY department_id
        ORDER BY salary_usd DESC, employee_id
    ) AS salary_pos
    FROM employees
)
SELECT *
FROM ranked
WHERE salary_pos = 1
ORDER BY department_id, salary_pos;

-- %% sql
