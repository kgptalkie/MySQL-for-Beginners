-- sqlnb v1 {"connection":"Local MySQL"}
-- %% sql
USE my_db;

-- %% sql
SELECT e.employee_id, e.first_name
FROM employees AS e
WHERE e.employee_id IN (1001, 1005, 1036, 1037,
    1039, 1044, 1045)
AND EXISTS (
    SELECT 1
    FROM employees AS r
    WHERE r.manager_id = e.employee_id
);

-- %% sql
SELECT e.employee_id, e.first_name
FROM employees AS e
WHERE e.employee_id IN (1001, 1005, 1036, 1037,
1039, 1044, 1045)
AND e.employee_id NOT IN (
    SELECT r.manager_id
    FROM employees AS r
);

-- %% sql
SELECT employee_id, first_name, manager_id
FROM employees
WHERE manager_id IS NULL;

-- %% sql
SELECT e.employee_id, e.first_name
FROM employees AS e
WHERE e.employee_id IN (1001, 1005, 1036, 1037,
1039, 1044, 1045)
AND NOT EXISTS (
    SELECT 1
    FROM employees AS r
    WHERE r.manager_id = e.employee_id
);

-- %% sql
