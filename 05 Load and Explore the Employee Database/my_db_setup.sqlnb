-- sqlnb v1 {"connection":"Local MySQL"}
-- %% sql
-- my_db: the employee database of MySQL for Beginners.
-- A made-up company: every name, number and date is fictional.
-- Money is in US dollars (USD). Every date is from 2000 to 2005.
--
-- Run it in SQL Notebook Studio: right-click this file, choose
-- Open as SQL Notebook, check that the notebook is on Local MySQL,
-- then Run All. In MySQL Workbench: open it and run the whole file.
--
-- Safe to run again: the first statement removes my_db if it
-- is already there, so every run gives the same, fresh data.
-- Anything you added to my_db yourself is removed with it.
--
-- Part 1. A fresh, empty database.
DROP DATABASE IF EXISTS my_db;

-- %% sql
CREATE DATABASE my_db;

-- %% sql
USE my_db;

-- %% sql
-- Part 2. The six tables, each parent before the tables that
-- point to it.
-- departments: one row is one department of the company.
-- It is a parent: employees and projects point to it.
CREATE TABLE departments (
  department_id INT PRIMARY KEY,
  department_name VARCHAR(40) NOT NULL UNIQUE,
  location VARCHAR(40) NOT NULL
);

-- %% sql
-- employees: one row is one employee, with the current job,
-- department, manager, hire date, salary and commission.
-- Two links: department_id points to departments, and
-- manager_id points back into employees itself (a manager is
-- an employee too). manager_id is empty (NULL) only for the
-- top of the company. commission_usd is NULL where no
-- commission applies.
CREATE TABLE employees (
  employee_id INT PRIMARY KEY,
  first_name VARCHAR(40) NOT NULL,
  last_name VARCHAR(40) NOT NULL,
  job_title VARCHAR(60) NOT NULL,
  department_id INT NOT NULL,
  manager_id INT,
  hire_date DATE NOT NULL,
  salary_usd DECIMAL(8,2) NOT NULL CHECK (salary_usd > 0),
  commission_usd DECIMAL(8,2),
  FOREIGN KEY (department_id)
    REFERENCES departments (department_id),
  FOREIGN KEY (manager_id)
    REFERENCES employees (employee_id)
);

-- %% sql
-- projects: one row is one project, owned by one department.
-- end_date is NULL while a project has no end date yet.
CREATE TABLE projects (
  project_id INT PRIMARY KEY,
  project_name VARCHAR(60) NOT NULL,
  department_id INT NOT NULL,
  start_date DATE NOT NULL,
  end_date DATE,
  budget_usd DECIMAL(8,2) NOT NULL,
  FOREIGN KEY (department_id)
    REFERENCES departments (department_id)
);

-- %% sql
-- employee_projects: one row is one employee working on one
-- project. Two links: to employees and to projects.
CREATE TABLE employee_projects (
  assignment_id INT PRIMARY KEY,
  employee_id INT NOT NULL,
  project_id INT NOT NULL,
  project_role VARCHAR(20) NOT NULL,
  assigned_on DATE NOT NULL,
  FOREIGN KEY (employee_id)
    REFERENCES employees (employee_id),
  FOREIGN KEY (project_id)
    REFERENCES projects (project_id)
);

-- %% sql
-- salary_history: one row is one salary of one employee, from
-- the day it took effect. The newest row of each employee
-- equals salary_usd in employees.
CREATE TABLE salary_history (
  history_id INT PRIMARY KEY,
  employee_id INT NOT NULL,
  salary_usd DECIMAL(8,2) NOT NULL,
  effective_from DATE NOT NULL,
  FOREIGN KEY (employee_id)
    REFERENCES employees (employee_id)
);

-- %% sql
-- employee_change_log: one row is one recorded change to an
-- employee (a salary review, a new job title, a move to
-- another department), with the old and the new value.
CREATE TABLE employee_change_log (
  change_id INT PRIMARY KEY,
  employee_id INT NOT NULL,
  change_date DATE NOT NULL,
  change_type VARCHAR(20) NOT NULL,
  old_value VARCHAR(60),
  new_value VARCHAR(60) NOT NULL,
  FOREIGN KEY (employee_id)
    REFERENCES employees (employee_id)
);

-- %% sql
-- Part 3. The rows, table by table, in the same order.
-- 10 departments. Research (70) has no employees yet.
INSERT INTO departments
  (department_id, department_name, location)
VALUES
