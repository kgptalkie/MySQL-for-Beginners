-- %% sql
USE my_db;

-- %% sql
SELECT COUNT(*) AS joined_rows,
SUM(e.salary_usd) AS payroll,
SUM(p.budget_usd) AS budget
FROM employees AS e
INNER JOIN projects AS p
ON e.department_id = p.department_id
WHERE e.department_id = 50;

-- %% sql
WITH emp_totals AS (
    SELECT department_id, COUNT(*) AS people,
    SUM(salary_usd) AS payroll
    FROM employees
    GROUP BY department_id
),
proj_totals AS (
    SELECT department_id, COUNT(*) AS projects,
    SUM(budget_usd) AS budget
    FROM projects
    GROUP BY department_id
)
SELECT et.people, et.payroll, pt.projects, pt.budget
FROM emp_totals AS et
INNER JOIN proj_totals AS pt
ON et.department_id = pt.department_id
WHERE et.department_id = 50;

-- %% sql
WITH emp_totals AS (
    SELECT department_id, COUNT(*) AS people,
    SUM(salary_usd) AS payroll
    FROM employees
    GROUP BY department_id
),
proj_totals AS (
    SELECT department_id, COUNT(*) AS projects,
    SUM(budget_usd) AS budget
    FROM projects
    GROUP BY department_id
)
SELECT d.department_name, et.people, et.payroll,
pt.projects, pt.budget
FROM departments AS d
LEFT JOIN emp_totals AS et
ON d.department_id = et.department_id
LEFT JOIN proj_totals AS pt
ON d.department_id = pt.department_id
ORDER BY et.payroll DESC;

-- %% sql
