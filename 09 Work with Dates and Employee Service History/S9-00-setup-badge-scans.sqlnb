-- %% sql
-- Section 9 setup: the badge_scans table (run once, after my_db is loaded).
-- Every time a Sales employee taps a badge at a door, the reader stores
-- the moment of the scan (scanned_at, a DATETIME) and the moment the
-- office system recorded it a few seconds later (recorded_at, a TIMESTAMP).
-- The other tables of my_db do not change.
USE my_db;

-- %% sql
CREATE TABLE badge_scans (
  scan_id INT PRIMARY KEY,
  employee_id INT NOT NULL,
  door VARCHAR(20) NOT NULL,
  scanned_at DATETIME NOT NULL,
  recorded_at TIMESTAMP NOT NULL,
  FOREIGN KEY (employee_id)
    REFERENCES employees (employee_id)
);

